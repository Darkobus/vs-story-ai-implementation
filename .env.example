# Copy this file to .env and fill in the values:  cp .env.example .env
# .env is ignored by git (it holds secrets) — do NOT commit it.

# Google Gemini API key — answers are generated in the cloud (the PC does no work).
# Get one at https://aistudio.google.com/apikey (starts with "AIza").
# Empty / missing = the bot uses local Ollama (MAIN_MODEL).
GEMINI_API_KEY=

# Host of the Ollama instance that computes embeddings (RAG). Defaults to the server's localhost.
# Change only if Ollama with nomic-embed-text runs on another machine.
OLLAMA_EMBED_HOST=127.0.0.1

# Vintage Story server RCON (required). Password = RconServer.Password in serverconfig.json.
VS_RCON_PASSWORD=
VS_RCON_HOST=127.0.0.1
VS_RCON_PORT=42421

# PC running Ollama — used for generation when GEMINI_API_KEY is empty
OLLAMA_PC_HOST=192.168.0.24
# 1 = if Gemini fails (quota/outage), try Ollama on the PC. Keep 0 if the PC is often off.
OLLAMA_FALLBACK=0

# Minimum gap (seconds) between questions from one player — spam and cost protection.
CHAT_COOLDOWN_SEC=10
