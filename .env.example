# Copy this file to .env and fill in the values:  cp .env.example .env
# .env is ignored by git (it holds secrets) — do NOT commit it.

# Google Gemini API key — answers are generated in the cloud (the PC does no work).
# Get one at https://aistudio.google.com/apikey (starts with "AIza").
# Empty / missing = the bot uses local Ollama (MAIN_MODEL).
GEMINI_API_KEY=

# Ollama instance that computes embeddings (RAG). Defaults to the server's localhost.
OLLAMA_EMBED_HOST=127.0.0.1
# Embedding model (multilingual, so Polish questions match English text). Run: ollama pull bge-m3
# Changing it requires rebuilding the knowledge base (ingest with --reset).
OLLAMA_EMBED_MODEL=bge-m3

# Knowledge base. VS_CHROMA_PATH defaults to <repo>/chroma_db.
VS_COLLECTION=vintage_story_kb
# VS_CHROMA_PATH=/home/user/vs-ai-watchdog/chroma_db
# Cosine distance above which a chunk is treated as irrelevant. Calibrate with tools/dbcheck.
# "off" disables the threshold.
RAG_MAX_DISTANCE=0.5
# 1 = translate questions to English before searching (extra LLM call; not needed with bge-m3)
RAG_TRANSLATE=0

# Game server Docker container (log source and asset source for ingest)
VS_CONTAINER=vs-ai-server

# Vintage Story server RCON (required). Password = RconServer.Password in serverconfig.json.
VS_RCON_PASSWORD=
VS_RCON_HOST=127.0.0.1
VS_RCON_PORT=42421

# PC running Ollama — used for generation when GEMINI_API_KEY is empty
OLLAMA_PC_HOST=192.168.0.24
# 1 = if Gemini fails (quota/outage), try Ollama on the PC. Keep 0 if the PC is often off.
OLLAMA_FALLBACK=0

# Minimum gap (seconds) between questions from one player — spam and cost protection.
CHAT_COOLDOWN_SEC=10
