# Skopiuj ten plik do .env i uzupełnij wartości:  cp .env.example .env
# Plik .env jest ignorowany przez git (trzyma sekrety) — NIE commituj go.

# Klucz API Google Gemini — generowanie odpowiedzi w chmurze (PC nie liczy).
# Weź z https://aistudio.google.com/apikey (zaczyna się od "AIza").
# Pusty / brak = bot używa lokalnej Ollamy (MAIN_MODEL).
GEMINI_API_KEY=

# Host Ollamy liczącej embeddingi (RAG). Domyślnie localhost serwera.
# Zmień tylko, jeśli Ollama z nomic-embed-text działa na innej maszynie.
OLLAMA_EMBED_HOST=127.0.0.1

# RCON serwera Vintage Story (wymagane). Hasło = RconServer.Password w serverconfig.json.
VS_RCON_PASSWORD=
VS_RCON_HOST=127.0.0.1
VS_RCON_PORT=42421

# PC z Ollamą — fallback generowania, gdy brak GEMINI_API_KEY
OLLAMA_PC_HOST=192.168.0.24
